{
  "name": "@recompose/desktop",
  "version": "0.2.0",
  "description": "recompose desktop shell",
  "homepage": "https://github.com/recomposesh/recompose",
  "license": "MIT",
  "author": "Alpcan Aydin <alpcan@alpcanaydin.com>",
  "main": "./out/main/index.js",
  "imports": {
    "#*": [
      "./*",
      "./*.ts",
      "./*.tsx"
    ]
  },
  "scripts": {
    "lint": "oxlint",
    "test": "vitest run --coverage",
    "test:mutation": "stryker run",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "install-electron && electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "pnpm run typecheck && pnpm run build && electron-builder --dir",
    "build:win": "pnpm run typecheck && pnpm run build && electron-builder --win --publish never",
    "build:mac": "pnpm run typecheck && pnpm run build && electron-builder --mac --publish never",
    "build:linux": "pnpm run typecheck && pnpm run build && electron-builder --linux --publish never",
    "generate:icons": "node scripts/generate-icons.mts",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test:e2e": "bddgen -c e2e/playwright.config.ts && playwright test -c e2e/playwright.config.ts --project acceptance --project proofs --grep-invert @quarantine",
    "test:e2e:leak": "playwright test -c e2e/playwright.config.ts --project leak --grep-invert @quarantine",
    "test:e2e:packaged": "playwright test -c e2e/playwright.config.ts --project packaged --grep-invert @quarantine",
    "test:e2e:visual": "playwright test -c e2e/playwright.config.ts --project visual --grep-invert @quarantine",
    "test:e2e:visual:update": "playwright test -c e2e/playwright.config.ts --project visual --update-snapshots",
    "test:e2e:quarantine": "bddgen -c e2e/playwright.config.ts && playwright test -c e2e/playwright.config.ts --project acceptance --project proofs --project leak --project visual --grep @quarantine --pass-with-no-tests"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@tanstack/react-router": "1.170.18",
    "electron-liquid-glass": "^1.1.1"
  },
  "devDependencies": {
    "@base-ui/react": "1.6.0",
    "@electron-toolkit/tsconfig": "2.0.0",
    "@electron/fuses": "2.1.3",
    "@fast-check/vitest": "0.4.1",
    "@playwright/test": "1.61.1",
    "@recompose/contracts": "workspace:*",
    "@recompose/engine": "workspace:*",
    "@resvg/resvg-js": "2.6.2",
    "@storybook/addon-a11y": "10.5.4",
    "@storybook/addon-mcp": "0.7.0",
    "@storybook/addon-themes": "10.5.4",
    "@storybook/addon-vitest": "10.5.4",
    "@storybook/react-vite": "10.5.4",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-query-devtools": "5.101.4",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tanstack/router-plugin": "1.168.23",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "chromatic": "18.1.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "electron-playwright-helpers": "2.1.0",
    "electron-vite": "6.0.0-beta.1",
    "fast-check": "4.9.0",
    "oxlint": "1.75.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright": "1.61.1",
    "playwright-bdd": "9.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "storybook": "10.5.4",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "vitest-browser-react": "2.2.0"
  },
  "desktopName": "recompose"
}
