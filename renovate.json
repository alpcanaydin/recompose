{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeExclude": ["@fission-ai/openspec"],
  "automerge": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "Pin bumps on ADR-trigger paths re-execute recorded decisions; take the adr-exempt escape hatch automatically",
      "matchFileNames": [".github/workflows/**", "mise.toml"],
      "addLabels": ["adr-exempt"],
      "prBodyNotes": [
        "ADR-exempt: automated dependency pin bump; the ADR that adopted this tool already records the decision."
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["pipx run zizmor==(?<currentValue>[0-9.]+)"],
      "depNameTemplate": "zizmor",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "go run github\\.com/rhysd/actionlint/cmd/actionlint@(?<currentValue>v[0-9.]+)"
      ],
      "depNameTemplate": "rhysd/actionlint",
      "datasourceTemplate": "github-releases"
    }
  ]
}
