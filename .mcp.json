{
  "mcpServers": {
    "mobbin": {
      "type": "http",
      "url": "https://api.mobbin.com/mcp"
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "hig": {
      "command": "pnpm",
      "args": ["exec", "hig-mcp"]
    },
    "storybook": {
      "type": "http",
      "url": "http://localhost:6006/mcp"
    },
    "playwright": {
      "command": "pnpm",
      "args": ["exec", "playwright-mcp"]
    }
  }
}
