{
  "guardEnabled": true,
  "ignorePatterns": [
    "*.md",
    "*.txt",
    "*.log",
    "*.json",
    "*.yml",
    "*.yaml",
    "*.xml",
    "*.html",
    "*.css",
    "**/.claude/*",
    "**/.claude/!(worktrees)/**",
    "**/*.config.*",
    "**/*.stories.tsx",
