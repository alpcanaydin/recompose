{
  "extends": "../../tsconfig.strict.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "esnext",
    "lib": ["esnext"],
    "types": ["node"],
    "typeRoots": ["../../apps/desktop/node_modules/@types"],
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["**/*.mts", "**/*.mjs"]
}
