{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/desktop": {
      "entry": [
        "build/after-pack.cjs",
        "e2e/playwright.config.ts",
        "e2e/fixtures.ts",
        "e2e/*.spec.ts",
        "e2e/steps/**/*.ts"
      ],
      "ignoreDependencies": ["chromatic", "fast-check"],
      "ignore": ["src/renderer/src/app/routeTree.gen.ts"]
    },
    "packages/contracts": {
      "entry": ["src/**/*.test-d.ts"],
      "ignoreDependencies": ["fast-check"]
    },
    ".": {
      "entry": ["steiger.config.ts"],
      "ignoreDependencies": ["@playwright/mcp", "@steiger/toolkit", "@swc/core"],
      "ignoreBinaries": ["mise"]
    }
  }
}
